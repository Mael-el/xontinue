# ============================================================
# ENVIRONNEMENT — AfricaSkills
# Copier vers .env et remplir les valeurs réelles.
# ============================================================

# --- Base de données PostgreSQL ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- URL publique (pour le seed initial) ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Paiements Mobile Money (FedaPay) ---
# Provider actif : mock (défaut, simulation) | fedapay | kkiapay
PAYMENTS_PROVIDER=mock
# Secret partagé vérifié par /api/v1/payments/webhook (HMAC en prod)
PAYMENTS_WEBHOOK_SECRET=dev-secret
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_MODE=sandbox

# --- Paiements Mobile Money (KkiaPay) ---
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=

# --- Stockage Cloudflare R2 ---
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=africaskills
CLOUDFLARE_R2_ENDPOINT=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=no-reply@africaskills.africa

# --- SMS (AfricasTalking) ---
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox

# --- Recherche (Meilisearch) ---
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=

# --- Redis (BullMQ, cache) ---
REDIS_URL=redis://localhost:6379

# --- Auth (à venir) ---
JWT_SECRET=
JWT_REFRESH_SECRET=
