# ============================================================
# ENVIRONNEMENT — AfricaSkills
# Copier vers .env et remplir les valeurs réelles.
# ============================================================

# --- Base de données PostgreSQL ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Taille max du pool de connexions (mettre 1 avec la base embarquée PGlite)
# DATABASE_POOL_MAX=1

# --- URL publique de l'application (liens emails, callbacks paiement) ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Paiements Mobile Money ---
# Provider actif : mock (défaut, simulation) | fedapay | kkiapay
PAYMENTS_PROVIDER=mock
# ⚠️ mock est INTERDIT en production sauf dérogation explicite (démo/staging)
# PAYMENTS_ALLOW_MOCK_IN_PROD=false
# Secret webhook : HMAC-SHA256 du corps brut (x-fedapay-signature / x-signature)
# ⚠️ OBLIGATOIRE en production — le webhook est refusé (503) sans lui
PAYMENTS_WEBHOOK_SECRET=dev-secret

# FedaPay (checkout hébergé : MTN, Orange, Moov, cartes)
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_MODE=sandbox

# KkiaPay (widget client — module dédié à venir)
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=

# --- Administration ---
# Requis en production pour autoriser POST /api/seed (curl -H "x-seed-secret: …")
# SEED_SECRET=

# --- Email transactionnel (Resend) ---
# Sans clé : provider console (dev) — les emails sont logués, pas envoyés
RESEND_API_KEY=
EMAIL_FROM=AfricaSkills <no-reply@africaskills.africa>

# --- SMS transactionnel (Africa's Talking) ---
# Sans clés : provider console (dev) — les SMS sont logués, pas envoyés
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
# AFRICASTALKING_SENDER_ID=

# --- Stockage Cloudflare R2 ---
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=africaskills
CLOUDFLARE_R2_ENDPOINT=

# --- Recherche (Meilisearch) ---
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=

# --- Redis (BullMQ, cache) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# ⚠️ OBLIGATOIRE en production : ≥ 32 caractères, aléatoires, distincts
# (le boot refuse les valeurs de développement : tokens forgables sinon)
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Temps réel (Espaces de travail + Messagerie) ---
# Serveur socket.io dédié : npm run realtime (port 3001)
# URL publique annoncée au navigateur (overrides : local/preview/prod)
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
# Secret partagé Next.js routes ↔ serveur temps réel (pont HTTP interne)
# ⚠️ OBLIGATOIRE en production : ≥ 32 caractères aléatoires
REALTIME_EMIT_SECRET=
# Port d'écoute du serveur temps réel
REALTIME_PORT=3001
